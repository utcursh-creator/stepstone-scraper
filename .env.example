# Proxy
PROXY_HOST=geo.iproyal.com
PROXY_PORT=12321
PROXY_USER=your_iproyal_username
PROXY_PASS=your_iproyal_password
PROXY_COUNTRY=DE

# StepStone Accounts (round-robin rotation). Account 2 is the fallback used when
# account 1 fails to authenticate — if either half of the _2 pair is unset,
# account 2 silently does not exist and account 1 drains twice as fast.
STEPSTONE_EMAIL_1=you@example.com
STEPSTONE_PASS_1=changeme
STEPSTONE_EMAIL_2=colleague@example.com
STEPSTONE_PASS_2=changeme

# AI evaluator (candidate matching).
#
# Set all THREE explicitly. LLM_BASE_URL and LLM_MODEL have defaults, but the
# defaults point at OpenRouter + a Claude model slug — so setting only
# LLM_API_KEY to an OpenAI key sends every request to OpenRouter, which 401s,
# and the job aborts after 3 consecutive evaluator errors.
#
# LLM_MODEL must be a STANDARD chat model. o-series reasoning models (o1, o3…)
# reject the max_tokens field this code sends and fail on every call.
#
# OPENROUTER_API_KEY is still accepted as an alias for LLM_API_KEY, so existing
# deployments keep working. On a NEW deployment set LLM_API_KEY and do not set
# the alias — if only the alias is set, the instance boots happily against
# whoever owns that key.
LLM_API_KEY=changeme
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
#
# To use OpenRouter instead:
# LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# LLM_MODEL=anthropic/claude-haiku-4-5

# Airtable
AIRTABLE_PAT=pat_changeme
AIRTABLE_BASE_ID=app_changeme
AIRTABLE_CANDIDATES_TABLE=tbl_changeme
AIRTABLE_CREDIT_TABLE=tbl_changeme

# n8n — the PRODUCTION /webhook/ path, never the editor's /webhook-test/ path
# (that one only accepts a request while "Listen for test event" is armed).
# The receiving workflow must be Active or this 404s and results are lost,
# while the scrape still runs and still spends credits.
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/stepstone-results

# Recruitee — see RECRUITEE_API_TOKEN below for the credential.
# NOTE: there is deliberately no RECRUITEE_API_KEY here. Settings ignores
# unknown variables (extra="ignore"), so a token placed under that name is
# silently dropped and the scraper unlocks profiles — spending real credits —
# while pushing nothing to Recruitee.
RECRUITEE_COMPANY_ID=61932

# 2captcha (fallback)
TWOCAPTCHA_API_KEY=changeme

# App
SCRAPE_TIMEOUT_SECONDS=1200
# Per-job candidate ceiling. The loop processes min(job.max_candidates, this).
# Central credit kill-switch — set to 10 for the capped BenSourcing run.
MAX_CANDIDATES_PER_JOB=50
# Hard daily ceiling on StepStone unlocks across ALL jobs (credit safety).
# Persisted in state/unlock_counter.json, resets daily. The true backstop
# behind per-job caps. For the BenSourcing run keep at 100. Set 0 to disable.
MAX_UNLOCKS_PER_DAY=100

# Distance gate — relocation feasibility cap (km).
# When a candidate's Wohnort is beyond the per-job max_distance_km BUT they
# listed the job city under "Gewünschter Arbeitsort", we used to accept them
# unconditionally as relocation candidates. This cap is the hard ceiling for
# that softening: a candidate 120 km away listing the job city as a desired
# location (e.g. Suraj-Apfeltrang case) is implausible even with stated
# relocation intent. Set to 0 to disable softening entirely (Wohnort-only
# mode, no relocation acceptance regardless of desire).
RELOCATION_MAX_DISTANCE_KM=200

# Recruitee — direct push (scraper uses these to create candidates)
# Set the real value as an environment variable, never in this file.
RECRUITEE_API_TOKEN=changeme

# Recruitee "Rejected Candidates - StepStone DirectSearch" pipeline (offer 2592624).
# ALL post-unlock-rejected candidates (too far / relocation-too-far / location
# unknown / foreign) are pushed here for manual recruiter review, labeled with
# the rejection reason in `sources` (e.g. "Abgelehnt: Aus Radius (Offer N)").
# Both vars must be set; either unset disables routing (rejects are dropped).
# Stage 13166770 = "Gesourct" (entry stage). Var names kept for backwards compat.
# Look up via:
#   curl -H "Authorization: Bearer $RECRUITEE_API_TOKEN" \
#     https://api.recruitee.com/c/61932/offers/<slug> | jq '.offer | .id'
RECRUITEE_TALENT_POOL_OFFER_ID=2592624
RECRUITEE_TALENT_POOL_STAGE_ID=13166770
